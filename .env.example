# ============================================================
# LogSentinel 环境变量模板
# 用法:复制本文件为 .env,再按需填写
# ⚠️ 千万不要把填好真实密钥的 .env 提交到 Git
# ============================================================

# ---- 运行环境 ----
# dev = 本地开发;prod = 线上(当前代码暂未读取,预留)
APP_ENV=dev

# ---- 数据库 ----
# 本地开发用 SQLite;生产可换 PostgreSQL,例如
# postgresql+psycopg2://user:password@host:5432/logsentry
DATABASE_URL=sqlite:///./data/logsentry.db

# ---- 大模型(全部留空也能跑,会自动降级为规则引擎)----
# 拿到 Key 后按下面格式填,例如 DeepSeek:
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- 异常检测 ----
# 指标超过基线的倍数就判定为异常(1.5 = 超出 50%)
ANOMALY_RATIO=1.5

# ---- 定时调度 ----
# true = 每分钟自动跑「解析 → 聚合 → 检测」;调试时可设为 false 关掉
SCHEDULER_ENABLED=true